SCRIPT CvNain
	extern float	block_state ();
	extern float	def_draw_state ();
	extern float	next_sig_lr ();
	extern float	sig_feature ();
	extern float	state;
	extern float	draw_state;
	extern float	enabled;

	float		mUser1;
	float		mDraw;

	mUser1	= sig_feature (SIGFEAT_USER1);
	state	= next_sig_lr (SIGFN_NORMAL);


	if (!enabled || block_state() !=# BLOCK_CLEAR )
		if ( !enabled || block_state() ==# BLOCK_JN_OBSTRUCTED || mUser1)
			mDraw = SIGASP_STOP;	
		else
			mDraw = SIGASP_CLEAR_2;
	else if ( next_sig_lr (SIGFN_NORMAL) ==# SIGASP_STOP )
		mDraw = SIGASP_STOP;	
	else
		mDraw = SIGASP_CLEAR_2;

	draw_state = def_draw_state (mDraw);
