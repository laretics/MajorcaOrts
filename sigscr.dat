SCRIPT exAL_CSAVL
	extern float	block_state ();
	extern float	route_set ();
	extern float	next_sig_lr ();
	extern float	sig_feature ();
	extern float	def_draw_state ();
	extern float	state;
	extern float	draw_state;
	extern float	enabled;

	float		mUser1;
	float		mUser2;
	float		mUser3;
	float		mUser4;
	float		next_state;

	mUser1		= sig_feature (SIGFEAT_USER1);
	mUser2		= sig_feature (SIGFEAT_USER2);
	mUser3		= sig_feature (SIGFEAT_USER3);
	mUser4		= sig_feature (SIGFEAT_USER4);
	next_state		= next_sig_lr (SIGFN_NORMAL);

	if (!enabled || block_state() !=# BLOCK_CLEAR )
		if ( !route_set() || block_state() ==# BLOCK_JN_OBSTRUCTED)
			state = SIGASP_STOP;	
		else if ( mUser1 )
			state = SIGASP_RESTRICTING;	
		else
			state = SIGASP_STOP_AND_PROCEED;
	else
		if ( next_state ==# SIGASP_STOP )
			state = SIGASP_STOP_AND_PROCEED;
		else if ( next_state <=# SIGASP_RESTRICTING)
			state = SIGASP_APPROACH_1;
		else if ( mUser2 && (next_state ==# SIGASP_APPROACH_1 ||
				next_state ==# SIGASP_APPROACH_3))
			state = SIGASP_APPROACH_2;
		else if ( mUser3 && next_state <=# SIGASP_APPROACH_3 )
			state = SIGASP_CLEAR_1;
		else 
			state = SIGASP_CLEAR_2;
	draw_state = def_draw_state (state);
