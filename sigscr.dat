///////////////////////////////////////////////////////////////////////////////
SCRIPT Info_0_7
///////////////////////////////////////
/// RM77 - SCRIPTS MODIFIES POUR OR ///
///////////////////////////////////////
	extern float	sig_feature ();
	extern float	state;
	extern float	draw_state;

	float		Bit1;
	float		Bit2;
	float		Bit3;
	float		Bit4;

	Bit1 =	sig_feature ( SIGFEAT_USER1 );
	Bit2 =	sig_feature ( SIGFEAT_USER2 );
	Bit3 =	sig_feature ( SIGFEAT_USER3 );
	Bit4 =	sig_feature ( SIGFEAT_USER4 );

	if ( (bit4 && bit3 && bit2 && bit1 ) ||(bit4 && bit3) ||( bit4 && bit2 && bit1 ))
		state = SIGASP_CLEAR_2;
	else if (( bit4 && bit2 )|| ( bit3 && bit2 && bit1 ))
		state = SIGASP_CLEAR_1;
	else if ( (bit4 && bit1 ) || ( bit3 && bit2 ))
		state = SIGASP_APPROACH_3;
	else if ( bit4 || (bit3 && bit1) )
		state = SIGASP_APPROACH_2;
	else if ( bit3 || (bit2 && bit1))
		state = SIGASP_APPROACH_1;
	else if ( bit2 )
		state = SIGASP_RESTRICTING;
	else if ( bit1 )
		state = SIGASP_STOP_AND_PROCEED;
	else
		state = SIGASP_STOP;

	draw_state = def_draw_state ( state );

/////////////////////////////////
SCRIPT RM_Id3d
	extern float	next_sig_lr ();
	extern float	def_draw_state ();
	extern float	state;
	extern float	draw_state;
	extern float	enabled;

	if ( next_sig_lr ( SIGFN_NORMAL ) ==# SIGASP_STOP )
		state = SIGASP_STOP;	
	else 
		state = next_sig_lr ( SIGFN_INFO );
	draw_state = def_draw_state (state);
///////////////////////////////////////////////////////////////////////////////
SCRIPT CSRR30AR30VL
	extern float	block_state ();
	extern float	route_set (); 
	extern float	next_sig_lr ();
	extern float	def_draw_state ();
	extern float	state;
	extern float	draw_state;
	extern float	enabled; 

	float	next_state;	

	next_state = next_sig_lr (SIGFN_NORMAL);
	if (!enabled ||	block_state() !=# BLOCK_CLEAR)
	{
		if (!enabled ||	block_state() ==# BLOCK_JN_OBSTRUCTED)
			state = SIGASP_STOP;	
		else
			state = SIGASP_STOP_AND_PROCEED;
	}
	// contre voie interdite
	else if ( next_state ==# SIGASP_STOP )
		state = SIGASP_STOP;
	// vers Garage
	else if ( next_state ==# SIGASP_APPROACH_3 )
		state = SIGASP_RESTRICTING;		
	// vers voie secondaire
	else if ( !route_set() )
	{
		if ( next_state <=# SIGASP_STOP_AND_PROCEED 
				|| next_state ==# SIGASP_APPROACH_3 
				|| next_state ==# SIGASP_CLEAR_2 )			
			state = SIGASP_RESTRICTING;
		else
			state = SIGASP_CLEAR_2;
	}
	else
	{
		if ( next_state <=# SIGASP_STOP_AND_PROCEED  )
			state = SIGASP_APPROACH_1;
		else if ( next_state ==# SIGASP_CLEAR_2 || next_state ==#SIGASP_RESTRICTING )
			state = SIGASP_APPROACH_2;
		else
			state = SIGASP_CLEAR_1;
	}

// Get draw state
	draw_state = def_draw_state (state);
/////////////////////////////////
SCRIPT CVM_horiz
	extern float	block_state ();
	extern float	route_set ();
	extern float	next_sig_lr ();
	extern float	sig_feature ();
	extern float	def_draw_state ();
	extern float	state;
	extern float	draw_state;
	extern float	enabled;

	float			has_number_plate;
	float			has_gradient_plate;
	float			next_state;

	has_number_plate	= sig_feature (SIGFEAT_NUMBER_PLATE);
	has_gradient_plate	= sig_feature (SIGFEAT_GRADIENT_PLATE);

	next_state = next_sig_lr (SIGFN_NORMAL);
	if (!enabled || block_state() !=# BLOCK_CLEAR || !route_set())
		if (has_gradient_plate)
			state = SIGASP_STOP_AND_PROCEED;
		else
			state = SIGASP_STOP;
	else if (next_state <=# SIGASP_STOP_AND_PROCEED  )
		state = SIGASP_APPROACH_3;
	else 		
		state = SIGASP_APPROACH_3;

// Get draw state
	draw_state = def_draw_state (state);
	if (state ==# SIGASP_RESTRICTING && !has_gradient_plate)
		draw_state = 1;
	draw_state = def_draw_state (state);

